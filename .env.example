# Copy to `.env` for local development. Never commit real values.
# See README.md for which values each process needs.

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=

# Server-only: the API/worker use this. NEVER expose it to the browser
# and NEVER commit a real value to git.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (used by migrations and RLS tests)
DATABASE_URL=

# FastAPI
API_PORT=8000

# Job queue
REDIS_URL=

# Public (browser-safe) Supabase values for apps/web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API hardening / observability (all optional; safe defaults) ---
# API environment name surfaced by /healthz
API_ENV=development
# JSON log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Error monitoring: set to enable Sentry (leave empty to disable)
SENTRY_DSN=
# Rate limiting kill switch + per-minute tiers
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_AI_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Idempotency-Key replay window
IDEMPOTENCY_TTL_HOURS=24
# Explicit feature-flag overrides (highest precedence): LF_FLAG_<KEY>=true|false
# e.g. LF_FLAG_DOCUMENT_ASSEMBLY=true
# Storage roots (local dev only; production uses Supabase Storage buckets)
DOCUMENT_STORAGE_DIR=
STORAGE_DIR=
DOWNLOAD_TOKEN_SECRET=
