{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"],
      "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "API_INTERNAL_URL"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "test": {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
