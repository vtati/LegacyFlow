# Copy to `.env` for local development. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Required-but-empty in Slice 1: declare the variable, leave the value empty
# until the API needs Supabase admin calls. Server-side only — never expose
# it to the browser (no NEXT_PUBLIC_ prefix) and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (used by local RLS tests / pgserver).
DATABASE_URL=
API_ENV=development
